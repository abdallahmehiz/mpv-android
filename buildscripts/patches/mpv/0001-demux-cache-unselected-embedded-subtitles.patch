+static void prune_embedded_subtitle_cache(struct demux_stream *ds)
+{
+    struct demux_internal *in = ds->in;
+    if (!ds->queue || !can_cache_embedded_subtitle(ds) || !in->num_ranges)
+        return;
+
+    int cached_queues = 0;
+    for (int n = 0; n < in->num_streams; n++) {
+        struct demux_stream *other = in->streams[n]->ds;
+        if (can_cache_embedded_subtitle(other))
+            cached_queues += in->num_ranges;
+    }
+    uint64_t max_bytes = MPMAX(1,
+        in->d_user->opts->unselected_sub_cache_max_bytes /
+        MPMAX(1, cached_queues));
+
+    for (int n = 0; n < in->num_ranges; n++) {
+        struct demux_queue *queue = in->ranges[n]->streams[ds->index];
+
+        if (in->last_playback_pts != MP_NOPTS_VALUE) {
+            double cutoff = in->last_playback_pts -
+                            in->d_user->opts->unselected_sub_cache_secs;
+
+            // Keep one packet at or before the cutoff. It can be a cue which
+            // is still active at the beginning of the retained history window.
+            while (queue->head && queue->head != ds->reader_head &&
+                   queue->head->next) {
+                struct demux_packet *next = queue->head->next;
+                double next_ts = MP_PTS_OR_DEF(next->pts, next->dts);
+                if (next_ts == MP_NOPTS_VALUE || next_ts > cutoff)
+                    break;
+
+                double head_ts = MP_PTS_OR_DEF(queue->head->pts,
+                                                queue->head->dts);
+                if (head_ts != MP_NOPTS_VALUE)
+                    queue->last_pruned = MP_PTS_MAX(queue->last_pruned,
+                                                    head_ts);
+                remove_head_packet(queue);
+            }
+        }
+
+        while (queue->head && queue->head != ds->reader_head &&
+               queue->tail_cum_pos - queue->head->cum_pos > max_bytes)
+        {
+            double head_ts = MP_PTS_OR_DEF(queue->head->pts,
+                                            queue->head->dts);
+            if (head_ts != MP_NOPTS_VALUE)
+                queue->last_pruned = MP_PTS_MAX(queue->last_pruned, head_ts);
+            remove_head_packet(queue);
+        }
+    }
+}
