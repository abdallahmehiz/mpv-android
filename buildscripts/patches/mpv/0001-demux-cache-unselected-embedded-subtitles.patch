+static bool can_cache_embedded_subtitle(struct demux_stream *ds)
+{
+    struct demux_internal *in = ds->in;
+
+    if (ds->type != STREAM_SUB || ds->sh->attached_picture ||
+        in->d_user->opts->unselected_sub_cache_secs <= 0 ||
+        in->d_user->opts->unselected_sub_cache_max_bytes <= 0)
+        return false;
+
+    // External subtitles use their own subtitle-only demuxer. Restrict this
+    // behavior to subtitle streams embedded alongside audio or video.
+    for (int n = 0; n < in->num_streams; n++) {
+        enum stream_type type = in->streams[n]->type;
+        if (type == STREAM_AUDIO || type == STREAM_VIDEO)
+            return true;
+    }
+
+    return false;
+}
